# Copy to .env and fill in. Never commit .env or the private key.
# Full walkthrough (sandbox in ~5 minutes) is in README.md.

# --- Server ---
# Port the HTTP server (dashboard + /metrics) listens on.
PORT=8080

# Path to the SQLite database file.
DB_PATH=./data/fynanz.db

# --- Enable Banking (open banking aggregator) ---
# Sandbox and production share one API host; the JWT's kid (your app id)
# selects the environment your app was registered to. Here the app is a
# SANDBOX app, so this is correct as-is. Verify with: make creds
# (https://enablebanking.com/cp to register/manage apps)
ENABLE_BANKING_URL=https://api.enablebanking.com

# Application ID you got when registering the app (JWT "kid" claim). It is a
# UUID, and — if you let the control panel generate the key — it is also the
# filename of the .pem downloaded at registration (e.g. aaaaaaaa-bbbb-cccc-
# dddd-eeeeeeeeeeee.pem). Verify both with: make creds
#
# OPTIONAL: credentials can also (and for deployed instances, preferably) be
# configured from the Settings → Enable Banking page, where they are stored
# in the database and override these env defaults — no env surgery on the
# server, no restart. The env values below then only serve local dev / as a
# fallback.
ENABLE_BANKING_APP_ID=

# Local dev (make dev): path to the private key .pem. Not needed when the key
# is stored via Settings. Docker: you may also mount the file instead —
# EB_KEY_HOST_PATH below.
ENABLE_BANKING_PRIVATE_KEY=

# Docker: host path of the .pem, mounted read-only into the container at
# /data/fynanz-key.pem. Only needed if you do NOT paste the key in Settings.
EB_KEY_HOST_PATH=

# URL the user returns to after bank consent. Must be registered in the app's
# allowed redirect URLs.
ENABLE_BANKING_REDIRECT_URL=http://localhost:8080/links/callback

# PSU type asked from the bank: "personal" or "business".
ENABLE_BANKING_PSU_TYPE=personal

# Cap on consent validity we request from the bank (days). The bank's own
# maximum applies anyway.
ENABLE_BANKING_MAX_CONSENT_DAYS=30

# --- Sync ---
# Interval for the scheduled sync job (Go duration, e.g. 24h / 12h).
SYNC_INTERVAL=24h

# How far back the first sync pulls transactions (days). Open question in
# AGENTS.md §12 — banks/PSD2 vary.
SYNC_HISTORY_DAYS=90

# --- Notifications (AGENTS.md §7) ---
# Channels are configured per-user in the DB via the Settings page
# (/settings) — ntfy or webhook, each with per-event routing. No env vars
# needed. PUBLIC_BASE_URL is only the outside origin used to build
# notification deep links (e.g. https://fynanz.your.domain for Tailscale).
PUBLIC_BASE_URL=http://localhost:8080

# --- Docker/homelab ---
# Traefik routing (README → "Homelab deployment"). Leave disabled for a
# plain `docker compose up`; when enabled, DOMAIN must be your hostname and
# the proxy network must exist.
TRAEFIK_ENABLE=false
DOMAIN=fynanz.example.com

# --- Auth (v2+, not enforced in v1; AGENTS.md §6) ---
# AUTH_MODE=none
# ADMIN_USER=
# ADMIN_PASSWORD=
