# Copy to .env and fill in. Never commit .env.

# --- Server ---
# Port the HTTP server (dashboard + API + /metrics) listens on.
PORT=8080

# Path to the SQLite database file.
DB_PATH=./data/fynanz.db

# --- Enable Banking (open banking aggregator) ---
# Credentials from your Enable Banking application (dashboard.enablebanking.com).
ENABLE_BANKING_URL=https://api.enablebanking.com
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_APP_SECRET=

# --- Sync ---
# How often the scheduled sync job runs (Go duration string, e.g. "24h", "12h").
SYNC_INTERVAL=24h

# --- Notifications (optional; see AGENTS.md §7) ---
# ntfy backend
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# webhook backend
WEBHOOK_URL=

# --- Auth (v2+, not enforced in v1) ---
# v1 ships with no login (trust the network boundary). Reserved for later.
# AUTH_MODE=none
# ADMIN_USER=
# ADMIN_PASSWORD=
